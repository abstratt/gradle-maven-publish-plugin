kotlinGradlePlugin {
  plugins [
    mavenPublishPlugin: {
      id "com.vanniktech.maven.publish"
      implementationClass "com.vanniktech.maven.publish.MavenPublishPlugin"
      displayName "Gradle Maven Publish Plugin"
      description "Gradle plugin that configures publish tasks to automatically upload all of your Java, Kotlin, Gradle, or Android libraries to any Maven instance."
    },
    mavenPublishBasePlugin: {
      id "com.vanniktech.maven.publish.base"
      implementationClass "com.vanniktech.maven.publish.MavenPublishBasePlugin"
      displayName "Gradle Maven Publish Base Plugin"
      description "Gradle plugin that configures publish tasks to automatically upload all of your Java, Kotlin, Gradle, or Android libraries to any Maven instance."
    }
  ]

  dokkaHtmlOutputDirectory "docs/api"
  // Generated by MkDocs.
  extraCleanPaths ["site"]

  buildConfig {
    packageName "com.vanniktech.maven.publish"
    fields [PLUGIN_NAME: "com.vanniktech.maven.publish"]
  }

  lint {
    baseline "lint-baseline.xml"
    ignoreTestSources true
    warningsAsErrors true
    disable ["NewerVersionAvailable", "GradleDependency", "AndroidGradlePluginVersion"]
  }

  integrationTestPublishedProjects [":central-portal"]

  dependencies {
    compileOnly [:dokka, :kotlin.plugin, :android.pluginApi]
    implementation [{ project ":central-portal" }]
    testImplementation [:junit.jupiter, :junit.engine, :junit.launcher, :truth]
    integrationTestImplementation [:testParameterInjector, :truth.testKit, :maven.model, :semver]
    lintChecks [:androidx.gradlePluginLints]
  }
}
